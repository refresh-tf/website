[{"data":1,"prerenderedAt":464},["ShallowReactive",2],{"/index/maps/metalworks":3,"/meta":246,"/maps/metalworks":323},{"id":4,"albumLink":5,"comparisons":6,"description":50,"extension":51,"githubLink":52,"meta":53,"name":57,"originalAuthors":192,"prefix":56,"refreshAuthors":194,"stem":195,"tf2mLink":59,"tftvLink":60,"thumbnail":58,"versions":196,"workshopLink":61,"__hash__":245},"maps/maps/metalworks.json","https://github.com/tom288/Refresh/blob/master/Metalworks/Metalworks_F1_Changelog.md",[7,11,14,18,21,23,25,28,31,33,35,38,40,43,46,48],{"name":8,"version":9,"title":10},"last1","f5","Last",{"name":12,"version":9,"title":13},"second1","Second",{"name":15,"version":16,"title":17},"mid1","f2","Mid",{"name":19,"version":16,"title":20},"spawn1","Spawn",{"name":22,"version":16,"title":10},"last2",{"name":24,"version":16,"title":10},"last3",{"name":26,"version":27,"title":10},"last4","f3",{"name":29,"version":16,"title":30},"lobby1","Lobby",{"name":32,"version":16,"title":30},"lobby2",{"name":34,"version":16,"title":13},"second2",{"name":36,"version":37,"title":13},"second3","f4",{"name":39,"version":9,"title":20},"spawn2",{"name":41,"version":16,"title":42},"ally","Alley",{"name":44,"version":9,"title":45},"house1","House",{"name":47,"version":9,"title":45},"house2",{"name":49,"version":16,"title":20},"spawn3","In this edit of Metalworks, we aimed to stay as close to the vanilla version as possible, while making hundreds of small adjustments to clipping and prop placement.\nOur main goal was to fix much of the loose decoration around the map that players commonly use for cover or movement. We addressed this by adding blockbullet brushes to those stacks or replacing them with brush-based structures.\nFinally, the geometry of the last point has been improved to better match the visuals. In the original Metalworks, players often struggled with combat due to props forming unstable ramps. In Refresh, we replaced these with clean brush ramps to allow smoother and more consistent fights.","json",null,{"path":54,"body":55,"title":191},"/maps/metalworks",{"prefix":56,"name":57,"thumbnail":58,"description":50,"tf2mLink":59,"tftvLink":60,"workshopLink":61,"albumLink":5,"githubLink":52,"originalAuthors":62,"refreshAuthors":66,"comparisons":71,"versions":88},"cp","metalworks","cp_metalworks.jpeg","https://tf2maps.net/downloads/refresh-metalworks.11992/","https://www.teamfortress.tv/60587/refresh-cp-metalworks","https://steamcommunity.com/sharedfiles/filedetails/?id=2649819304",[63],{"comment":64,"link":65},"The original map cp_metalworks was made by Ian \"ScorpioUprising\" Cuslidge.","https://wiki.teamfortress.com/wiki/Metalworks",[67,68,69,70],"76561198072335921","76561198017283362","76561198119324108","76561198031558094",[72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87],{"name":8,"version":9,"title":10},{"name":12,"version":9,"title":13},{"name":15,"version":16,"title":17},{"name":19,"version":16,"title":20},{"name":22,"version":16,"title":10},{"name":24,"version":16,"title":10},{"name":26,"version":27,"title":10},{"name":29,"version":16,"title":30},{"name":32,"version":16,"title":30},{"name":34,"version":16,"title":13},{"name":36,"version":37,"title":13},{"name":39,"version":9,"title":20},{"name":41,"version":16,"title":42},{"name":44,"version":9,"title":45},{"name":47,"version":9,"title":45},{"name":49,"version":16,"title":20},[89,99,106,121,131,141,157],{"suffix":90,"download":91,"date":92,"changes":93},"f7","https://dl.serveme.tf/maps/cp_metalworks_f7.bsp","08/07/2025",[94,97],{"type":95,"message":96},"fix","Fixed shadows going through walls in problematic locations.",{"type":95,"message":98},"Fixed blue house above choke on second being non solid and improved splash on props near it.",{"suffix":100,"download":101,"date":102,"changes":103},"f6","https://dl.serveme.tf/maps/cp_metalworks_f6.bsp","27/06/2025",[104],{"type":95,"message":105},"Fixed getting stuck in the ground in valley.",{"suffix":9,"download":107,"date":108,"changes":109},"